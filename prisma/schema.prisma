// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                      String   @id @default(cuid())
  name                    String
  email                   String   @unique
  password                String
  role                    String   @default("BUYER") // BUYER, ADMIN, SHOP_OWNER
  phone                   String?
  avatar                  String?
  emailVerifiedAt         DateTime?
  emailNotifications      Boolean  @default(true)
  emailDeliveryStatus     String   @default("ACTIVE")
  emailDeliveryReason     String?
  emailDeliveryAt         DateTime?
  sessionVersion          Int      @default(0)
  adminMfaSecret          String?
  adminMfaEnabledAt       DateTime?
  adminMfaRecoveryCodes   String?
  adminMfaLastCounter     BigInt?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  store                   Store?
  storesVerified          Store[]              @relation("StoreVerifier")
  storesModerated         Store[]              @relation("StoreModerator")
  orders                  Order[]
  productReviews          ProductReview[]
  storeReviews            StoreReview[]
  notifications           Notification[]
  wishlist                Wishlist[]
  storeWishlist           StoreWishlist[]
  userCars                UserCar[]
  sentMessages            ChatMessage[]        @relation("ChatMessageSender")
  receivedMessages        ChatMessage[]        @relation("ChatMessageReceiver")
  sentProductMessages     ProductMessage[]     @relation("ProductMessageSender")
  receivedProductMessages ProductMessage[]     @relation("ProductMessageReceiver")
  reportsGiven            Report[]             @relation("ReportReporter")
  reportsReviewed         Report[]             @relation("ReportReviewer")
  loginVerifications      LoginVerification[]
  passwordResets          PasswordReset[]
  disputes                Dispute[]            @relation("DisputeBuyer")
  disputesReviewed        Dispute[]            @relation("DisputeReviewer")
  auditLogs               AuditLog[]
  aiConversations         AIConversation[]
  aiActionProposals       AIActionProposal[]
  supportTickets          SupportTicket[]      @relation("SupportTicketRequester")
  supportMessages         SupportMessage[]     @relation("SupportMessageAuthor")
  emailDeliveryAttempts   EmailDeliveryAttempt[] @relation("EmailDeliveryRecipient")
  adminMfaChallenges      AdminMfaChallenge[]
  emailChangeRequest      EmailChangeRequest?

  @@index([emailDeliveryStatus])
}

model PasswordReset {
  id        String    @id
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@index([userId, usedAt, expiresAt])
}

model LoginVerification {
  id         String    @id
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose    String    @default("LOGIN")
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@index([userId, purpose, expiresAt])
}

model AdminMfaChallenge {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose         String
  secretEncrypted String?
  attempts        Int       @default(0)
  expiresAt       DateTime
  consumedAt      DateTime?
  createdAt       DateTime  @default(now())

  @@index([userId, purpose, expiresAt])
  @@index([expiresAt])
}

model EmailChangeRequest {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetEmail String   @unique
  codeHash    String
  attempts    Int      @default(0)
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([expiresAt])
}

model Store {
  id                   String              @id @default(cuid())
  name                 String
  description          String?
  address              String?
  phone                String?
  image                String?
  verified             Boolean             @default(false)
  verificationStatus   String              @default("UNVERIFIED")
  verifiedAt           DateTime?
  verifiedStoreName    String?
  verifiedBusinessName String?
  verifiedPhone        String?
  verifiedAddress      String?
  verifiedImage        String?
  verifiedById         String?
  verifiedBy           User?               @relation("StoreVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  moderationStatus     String              @default("ACTIVE")
  moderationReason     String?
  moderatedAt          DateTime?
  moderatedById        String?
  moderatedBy          User?               @relation("StoreModerator", fields: [moderatedById], references: [id], onDelete: SetNull)
  ownerId              String              @unique
  owner                User                @relation(fields: [ownerId], references: [id])
  parts                Part[]
  orders               Order[]
  reviews              StoreReview[]
  coupons              Coupon[]
  wishlist             StoreWishlist[]
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  verification         SellerVerification?
  disputes             Dispute[]

  @@index([moderationStatus, createdAt])
  @@index([verificationStatus, createdAt])
  @@index([verifiedById])
  @@index([moderatedById])
}

model Part {
  id              String                 @id @default(cuid())
  name            String
  description     String?
  price           Float
  stock           Int                    @default(0)
  category        String?
  brand           String?
  partNumber      String?
  oemNumber       String?
  searchAliases   String?
  condition       String?
  universal       Boolean                @default(false)
  fitmentNotes    String?
  image           String?
  // Car compatibility - stored as JSON string for legacy compatibility.
  carModels       String?
  storeId         String
  store           Store                  @relation(fields: [storeId], references: [id])
  orders          Order[]
  orderItems      OrderItem[]
  reviews         ProductReview[]
  images          PartImage[]
  productMessages ProductMessage[]
  wishlist        Wishlist[]
  compatibilities VehicleCompatibility[]
  blocked         Boolean                @default(false)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([storeId, createdAt])
  @@index([blocked, createdAt])
  @@index([category])
  @@index([brand])
  @@index([partNumber])
  @@index([oemNumber])
  @@index([condition])
}

model VehicleCompatibility {
  id         String   @id @default(cuid())
  partId     String
  part       Part     @relation(fields: [partId], references: [id], onDelete: Cascade)
  make       String
  model      String
  generation String?
  engine     String?
  trim       String?
  notes      String?
  yearFrom   Int?
  yearTo     Int?
  createdAt  DateTime @default(now())

  @@index([make, model, yearFrom, yearTo])
  @@index([make, model, generation, engine])
  @@index([partId])
}

model RateLimitBucket {
  key       String   @id
  count     Int      @default(1)
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

model AIConversation {
  id        String             @id @default(cuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String
  title     String?
  expiresAt DateTime
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  messages  AIMessage[]
  proposals AIActionProposal[]

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model AIMessage {
  id             String         @id @default(cuid())
  conversationId String
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String
  metadata       String?
  createdAt      DateTime       @default(now())

  @@index([conversationId, createdAt])
}

model AIActionProposal {
  id             String         @id @default(cuid())
  conversationId String
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String
  action         String
  payload        String
  summary        String
  status         String         @default("PENDING")
  idempotencyKey String         @unique
  expiresAt      DateTime
  executedAt     DateTime?
  createdAt      DateTime       @default(now())

  @@index([userId, status, expiresAt])
  @@index([conversationId, createdAt])
  @@index([expiresAt])
}

model AIRequestLease {
  id        String   @id @default(cuid())
  key       String
  token     String   @unique
  role      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([key, expiresAt])
  @@index([expiresAt])
}

model PartImage {
  id        String   @id @default(cuid())
  partId    String
  part      Part     @relation(fields: [partId], references: [id], onDelete: Cascade)
  url       String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([partId, position])
}

model Order {
  id                  String          @id @default(cuid())
  partId              String
  part                Part            @relation(fields: [partId], references: [id])
  storeId             String
  store               Store           @relation(fields: [storeId], references: [id])
  buyerId             String
  buyer               User            @relation(fields: [buyerId], references: [id])
  quantity            Int             @default(1)
  totalPrice          Float
  status              String          @default("PENDING")
  paymentStatus       String          @default("UNPAID")
  paymentMethod       String?
  deliveryAddress     String
  governorate         String?
  shippingFee         Float           @default(0)
  estimatedDeliveryAt DateTime?
  trackingNumber      String?
  notes               String?
  couponCode          String?
  discount            Float           @default(0)
  clientOrderId       String?         @unique
  timeline            OrderTimeline[]
  chatMessages        ChatMessage[]
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  disputes            Dispute[]
  items               OrderItem[]
  supportTickets      SupportTicket[]

  @@index([buyerId, createdAt])
  @@index([storeId, createdAt])
}

model OrderItem {
  id           String   @id @default(cuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  partId       String?
  part         Part?    @relation(fields: [partId], references: [id], onDelete: SetNull)
  productName  String
  productImage String?
  unitPrice    Float
  quantity     Int
  discount     Float    @default(0)
  itemTotal    Float
  createdAt    DateTime @default(now())

  @@index([orderId])
  @@index([partId])
}

model OrderTimeline {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    String
  note      String?
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}

model ProductReview {
  id              String   @id @default(cuid())
  partId          String
  part            Part     @relation(fields: [partId], references: [id])
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  rating          Int
  sellerRating    Int?
  packagingRating Int?
  deliveryRating  Int?
  orderId         String?
  comment         String?
  blocked         Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@unique([userId, partId])
  @@index([partId, createdAt])
  @@index([userId])
}

model StoreReview {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  rating    Int
  comment   String?
  blocked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([userId, storeId])
  @@index([storeId, createdAt])
  @@index([userId])
}

model Notification {
  id            String                @id @default(cuid())
  userId        String
  user          User                  @relation(fields: [userId], references: [id])
  title         String
  message       String
  type          String
  read          Boolean               @default(false)
  link          String?
  dedupeKey     String?               @unique
  createdAt     DateTime              @default(now())
  emailDelivery EmailDeliveryAttempt?

  @@index([userId, read, createdAt])
}

model EmailDeliveryAttempt {
  id              String        @id @default(cuid())
  notificationId  String?       @unique
  notification    Notification? @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  recipientUserId String?
  recipientUser   User?         @relation("EmailDeliveryRecipient", fields: [recipientUserId], references: [id], onDelete: SetNull)
  providerId      String?
  recipientEmail  String?
  deliveryKey     String        @unique
  category        String        @default("NOTIFICATION")
  status          String
  error           String?
  lastEventId     String?
  lastEventAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([providerId])
  @@index([recipientUserId])
  @@index([category, createdAt])
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  partId    String
  part      Part     @relation(fields: [partId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, partId])
}

model StoreWishlist {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, storeId])
  @@index([storeId])
}

model UserCar {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  brand      String
  model      String
  generation String?
  year       Int?
  engine     String?
  trim       String?
  isPrimary  Boolean  @default(false)
  nickname   String?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
}

model SellerVerification {
  id           String    @id @default(cuid())
  storeId      String    @unique
  store        Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  documentUrls String
  businessName String?
  status       String    @default("PENDING")
  adminNote    String?
  submittedAt  DateTime  @default(now())
  reviewedAt   DateTime?
}

model Dispute {
  id           String   @id @default(cuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  buyerId      String
  buyer        User     @relation("DisputeBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  storeId      String
  store        Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  type         String
  reason       String
  evidenceUrls String?
  status       String   @default("OPEN")
  resolution   String?
  reviewedById String?
  reviewedBy   User?    @relation("DisputeReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([orderId, buyerId, status])
  @@index([status, createdAt])
  @@index([orderId])
  @@index([buyerId])
  @@index([storeId])
  @@index([reviewedById])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  targetType String
  targetId   String?
  metadata   String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
}

model SupportTicket {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation("SupportTicketRequester", fields: [userId], references: [id], onDelete: Cascade)
  orderId   String?
  order     Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)
  category  String           @default("GENERAL")
  subject   String
  status    String           @default("OPEN")
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  messages  SupportMessage[]

  @@index([userId, updatedAt])
  @@index([status, updatedAt])
  @@index([orderId])
}

model SupportMessage {
  id         String        @id @default(cuid())
  ticketId   String
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId   String?
  author     User?         @relation("SupportMessageAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  authorRole String
  body       String
  createdAt  DateTime      @default(now())

  @@index([ticketId, createdAt])
  @@index([authorId, createdAt])
}

model Coupon {
  id              String    @id @default(cuid())
  code            String    @unique
  storeId         String
  store           Store     @relation(fields: [storeId], references: [id])
  discountPercent Float
  maxUses         Int       @default(100)
  usedCount       Int       @default(0)
  active          Boolean   @default(true)
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())

  @@index([storeId, active])
}

model ChatMessage {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  senderId   String
  sender     User     @relation("ChatMessageSender", fields: [senderId], references: [id])
  receiverId String
  receiver   User     @relation("ChatMessageReceiver", fields: [receiverId], references: [id])
  message    String
  imageUrl   String?
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([senderId, receiverId])
  @@index([receiverId, read])
  @@index([orderId, createdAt])
}

model ProductMessage {
  id         String   @id @default(cuid())
  partId     String
  part       Part     @relation(fields: [partId], references: [id], onDelete: Cascade)
  senderId   String
  sender     User     @relation("ProductMessageSender", fields: [senderId], references: [id])
  receiverId String
  receiver   User     @relation("ProductMessageReceiver", fields: [receiverId], references: [id])
  message    String
  imageUrl   String?
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([partId])
  @@index([senderId, receiverId])
  @@index([receiverId, read])
}

model Report {
  id           String   @id @default(cuid())
  reporterId   String
  reporter     User     @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  targetType   String
  targetId     String
  reason       String
  details      String?
  status       String   @default("OPEN")
  reviewedById String?
  reviewedBy   User?    @relation("ReportReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([reporterId, targetType, targetId, status])
  @@index([status, createdAt])
  @@index([targetType, targetId])
}

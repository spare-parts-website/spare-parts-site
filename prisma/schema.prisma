// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                 String   @id @default(cuid())
  name               String
  email              String   @unique
  password           String
  role               String   @default("BUYER") // BUYER, ADMIN, SHOP_OWNER
  phone              String?
  avatar             String?
  emailNotifications Boolean  @default(true)
  sessionVersion     Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  store                   Store?
  orders                  Order[]
  productReviews          ProductReview[]
  storeReviews            StoreReview[]
  notifications           Notification[]
  wishlist                Wishlist[]
  storeWishlist           StoreWishlist[]
  userCars                UserCar[]
  sentMessages            ChatMessage[]       @relation("ChatMessageSender")
  receivedMessages        ChatMessage[]       @relation("ChatMessageReceiver")
  sentProductMessages     ProductMessage[]    @relation("ProductMessageSender")
  receivedProductMessages ProductMessage[]    @relation("ProductMessageReceiver")
  reportsGiven            Report[]            @relation("ReportReporter")
  reportsReviewed         Report[]            @relation("ReportReviewer")
  loginVerifications      LoginVerification[]
  passwordResets          PasswordReset[]
  disputes                Dispute[]           @relation("DisputeBuyer")
  disputesReviewed        Dispute[]           @relation("DisputeReviewer")
  auditLogs               AuditLog[]
}

model PasswordReset {
  id        String    @id
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@index([userId, usedAt, expiresAt])
}

model LoginVerification {
  id         String    @id
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model Store {
  id                 String              @id @default(cuid())
  name               String
  description        String?
  address            String?
  phone              String?
  image              String?
  verified           Boolean             @default(false)
  verificationStatus String              @default("UNVERIFIED")
  verifiedAt         DateTime?
  ownerId            String              @unique
  owner              User                @relation(fields: [ownerId], references: [id])
  parts              Part[]
  orders             Order[]
  reviews            StoreReview[]
  coupons            Coupon[]
  wishlist           StoreWishlist[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  verification       SellerVerification?
  disputes           Dispute[]
}

model Part {
  id              String                 @id @default(cuid())
  name            String
  description     String?
  price           Float
  stock           Int                    @default(0)
  category        String?
  brand           String?
  partNumber      String?
  oemNumber       String?
  searchAliases   String?
  condition       String?
  image           String?
  // Car compatibility - stored as JSON string: e.g. '["Toyota Camry 2018-2023", "Honda Accord 2019-2022"]'
  carModels       String?
  storeId         String
  store           Store                  @relation(fields: [storeId], references: [id])
  orders          Order[]
  reviews         ProductReview[]
  images          PartImage[]
  productMessages ProductMessage[]
  wishlist        Wishlist[]
  compatibilities VehicleCompatibility[]
  blocked         Boolean                @default(false)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([storeId, createdAt])
  @@index([blocked, createdAt])
  @@index([category])
  @@index([brand])
  @@index([partNumber])
  @@index([oemNumber])
  @@index([condition])
}

model VehicleCompatibility {
  id        String   @id @default(cuid())
  partId    String
  part      Part     @relation(fields: [partId], references: [id], onDelete: Cascade)
  make      String
  model     String
  yearFrom  Int?
  yearTo    Int?
  createdAt DateTime @default(now())

  @@index([make, model, yearFrom, yearTo])
  @@index([partId])
}

model RateLimitBucket {
  key       String   @id
  count     Int      @default(1)
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

// Multiple images for a part
model PartImage {
  id        String   @id @default(cuid())
  partId    String
  part      Part     @relation(fields: [partId], references: [id], onDelete: Cascade)
  url       String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([partId, position])
}

model Order {
  id                  String          @id @default(cuid())
  partId              String
  part                Part            @relation(fields: [partId], references: [id])
  storeId             String
  store               Store           @relation(fields: [storeId], references: [id])
  buyerId             String
  buyer               User            @relation(fields: [buyerId], references: [id])
  quantity            Int             @default(1)
  totalPrice          Float
  status              String          @default("PENDING") // PENDING, APPROVED, REJECTED, PAID, DELIVERED, RETURNED
  paymentStatus       String          @default("UNPAID") // UNPAID, PAID, REFUNDED
  paymentMethod       String?
  deliveryAddress     String
  governorate         String?
  shippingFee         Float           @default(0)
  estimatedDeliveryAt DateTime?
  trackingNumber      String?
  notes               String?
  couponCode          String?
  discount            Float           @default(0)
  clientOrderId       String?         @unique
  timeline            OrderTimeline[]
  chatMessages        ChatMessage[]
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  disputes            Dispute[]

  @@index([buyerId, createdAt])
  @@index([storeId, createdAt])
}

// Order status timeline (track each status change)
model OrderTimeline {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    String // PENDING, APPROVED, REJECTED, PAID, DELIVERED, RETURNED
  note      String?
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}

model ProductReview {
  id              String   @id @default(cuid())
  partId          String
  part            Part     @relation(fields: [partId], references: [id])
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  rating          Int
  sellerRating    Int?
  packagingRating Int?
  deliveryRating  Int?
  orderId         String?
  comment         String?
  blocked         Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([partId, createdAt])
  @@index([userId])
}

model StoreReview {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  rating    Int
  comment   String?
  blocked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([storeId, createdAt])
  @@index([userId])
}

model Notification {
  id            String                @id @default(cuid())
  userId        String
  user          User                  @relation(fields: [userId], references: [id])
  title         String
  message       String
  type          String // ORDER_STATUS, NEW_ORDER, PAYMENT, REVIEW, SYSTEM, CHAT
  read          Boolean               @default(false)
  link          String?
  createdAt     DateTime              @default(now())
  emailDelivery EmailDeliveryAttempt?

  @@index([userId, read, createdAt])
}

model EmailDeliveryAttempt {
  id             String       @id @default(cuid())
  notificationId String       @unique
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  providerId     String?
  status         String
  error          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([status, createdAt])
}

// Wishlist - users save favorite parts
model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  partId    String
  part      Part     @relation(fields: [partId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, partId])
}

// Users save favorite stores. The legacy Wishlist model above is retained only
// for existing database compatibility and is no longer used by the application.
model StoreWishlist {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, storeId])
  @@index([storeId])
}

// User's saved cars (car profiles)
model UserCar {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  brand     String // Toyota, Honda, etc.
  model     String // Camry, Civic, etc.
  year      Int?
  engine    String?
  isPrimary Boolean  @default(false)
  nickname  String? // "سيارة العمل", "سيارة العائلة"
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model SellerVerification {
  id           String    @id @default(cuid())
  storeId      String    @unique
  store        Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  documentUrls String
  businessName String?
  status       String    @default("PENDING")
  adminNote    String?
  submittedAt  DateTime  @default(now())
  reviewedAt   DateTime?
}

model Dispute {
  id           String   @id @default(cuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  buyerId      String
  buyer        User     @relation("DisputeBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  storeId      String
  store        Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  type         String
  reason       String
  evidenceUrls String?
  status       String   @default("OPEN")
  resolution   String?
  reviewedById String?
  reviewedBy   User?    @relation("DisputeReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([orderId, buyerId, status])
  @@index([status, createdAt])
  @@index([orderId])
  @@index([buyerId])
  @@index([storeId])
  @@index([reviewedById])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  targetType String
  targetId   String?
  metadata   String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
}

// Discount coupons
model Coupon {
  id              String    @id @default(cuid())
  code            String    @unique
  storeId         String
  store           Store     @relation(fields: [storeId], references: [id])
  discountPercent Float // e.g. 10 = 10% off
  maxUses         Int       @default(100)
  usedCount       Int       @default(0)
  active          Boolean   @default(true)
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())

  @@index([storeId, active])
}

// Chat messages between buyer and store owner
model ChatMessage {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  senderId   String
  sender     User     @relation("ChatMessageSender", fields: [senderId], references: [id])
  receiverId String
  receiver   User     @relation("ChatMessageReceiver", fields: [receiverId], references: [id])
  message    String
  imageUrl   String?
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([senderId, receiverId])
  @@index([receiverId, read])
  @@index([orderId, createdAt])
}

// Messages about a product before an order exists
model ProductMessage {
  id         String   @id @default(cuid())
  partId     String
  part       Part     @relation(fields: [partId], references: [id], onDelete: Cascade)
  senderId   String
  sender     User     @relation("ProductMessageSender", fields: [senderId], references: [id])
  receiverId String
  receiver   User     @relation("ProductMessageReceiver", fields: [receiverId], references: [id])
  message    String
  imageUrl   String?
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([partId])
  @@index([senderId, receiverId])
  @@index([receiverId, read])
}

model Report {
  id           String   @id @default(cuid())
  reporterId   String
  reporter     User     @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  targetType   String // part, store, user
  targetId     String
  reason       String
  details      String?
  status       String   @default("OPEN") // OPEN, REVIEWED, DISMISSED, BLOCKED
  reviewedById String?
  reviewedBy   User?    @relation("ReportReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([reporterId, targetType, targetId, status])
  @@index([status, createdAt])
  @@index([targetType, targetId])
}
